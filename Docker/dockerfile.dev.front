FROM node:26 as builder

WORKDIR /app

COPY package*.json ./

RUN npm ci

FROM node:26
COPY --from=builder /app/node_modules ./node_modules

COPY  /public ./public
COPY /src ./src
COPY .eslintrc.cjs ./
COPY index.html ./
COPY jsconfig.json ./
COPY vite.config.js ./

EXPOSE 5173
CMD ["npm","run","dev"]